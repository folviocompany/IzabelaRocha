---
import { waLink } from "../data/site";
---

<section class="grain relative overflow-hidden bg-gradient-to-r from-wine-800 via-wine-700 to-wine-800 py-20">
  <!-- Ornamentos -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-500/60 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-gold-500/60 to-transparent" aria-hidden="true"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div
      class="h-72 w-[36rem] rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, rgba(201,162,39,0.9) 0%, transparent 60%)"
      data-parallax="0.14"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-3xl px-5 text-center" data-reveal>
    <h2 class="font-display text-3xl font-medium text-white sm:text-4xl">
      Pronta para se sentir <em class="gold-text gold-shimmer italic">ainda mais</em> confiante?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base font-light text-white/65">
      Agende sua avaliação e receba um plano de tratamento pensado exclusivamente para você.
    </p>
    <a href={waLink()} target="_blank" rel="noopener" class="btn btn-gold mt-8">
      Agendar pelo WhatsApp
    </a>
  </div>
</section>
