---
import { waLink } from "../data/site";
---

<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp e agendar avaliação"
  class="group fixed right-5 bottom-5 z-50 flex items-center gap-3 lg:right-7 lg:bottom-7"
>
  <!-- Rótulo (aparece no hover, desktop) -->
  <span class="pointer-events-none hidden translate-x-2 rounded-full bg-wine-950/90 px-4 py-2 text-xs font-medium tracking-wide text-white opacity-0 shadow-lg backdrop-blur transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 lg:block">
    Agende sua avaliação
  </span>

  <span class="relative grid h-14 w-14 place-items-center">
    <span class="wa-ping absolute inset-0 rounded-full bg-[#25D366]" aria-hidden="true"></span>
    <span class="relative grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_12px_30px_-8px_rgba(37,211,102,0.7)] transition-transform duration-300 group-hover:scale-110">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.1 3.2 5.1 4.49.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35M12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.4 9.4 0 0 1-1.45-5.03c0-5.21 4.25-9.45 9.47-9.45a9.4 9.4 0 0 1 6.69 2.77 9.4 9.4 0 0 1 2.77 6.7c0 5.21-4.25 9.44-9.46 9.44m8.05-17.5A11.3 11.3 0 0 0 12.03.68C5.77.68.68 5.77.68 12.02c0 2 .52 3.95 1.52 5.67L.6 23.5l5.94-1.56a11.35 11.35 0 0 0 5.48 1.4h.01c6.26 0 11.35-5.1 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02" />
      </svg>
    </span>
  </span>
</a>
