---
import ComparisonCard from "./ComparisonCard.astro";
import { beforeAfter, waLink } from "../data/site";

const verticalCases = beforeAfter.filter((c) => c.layout === "portrait" || c.layout === "tall");
const horizontalCases = beforeAfter.filter((c) => c.layout === "square" || c.layout === "wide");
---

<section id="resultados" class="grain relative overflow-hidden bg-wine-950 py-24 lg:py-32">
  <!-- Brilho decorativo com parallax -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div
      class="h-96 w-[50rem] rounded-full opacity-15 blur-3xl"
      style="background: radial-gradient(circle, rgba(201,162,39,0.8) 0%, transparent 60%)"
      data-parallax="0.18"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow eyebrow-center text-gold-400">Antes & Depois</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-white sm:text-[2.6rem] sm:leading-tight">
        Resultados que falam <em class="gold-text gold-shimmer italic">por si</em>
      </h2>
      <p class="mt-5 text-base leading-relaxed font-light text-white/60">
        Arraste a linha para comparar o antes e o depois. Casos reais de pacientes,
        fruto de avaliação criteriosa e técnica apurada.
      </p>
    </div>

    <!-- Casos verticais: cards na proporção natural das fotos -->
    <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {verticalCases.map((item, i) => (
        <ComparisonCard item={item} delay={(i % 3) * 0.08} />
      ))}
    </div>

    <!-- Casos horizontais: HIFU + Toxina em cards equilibrados no desktop -->
    <div class:list={["mx-auto mt-6 grid gap-6", horizontalCases.length === 1 ? "max-w-md" : "max-w-4xl sm:grid-cols-2"]}>
      {horizontalCases.map((item) => (
        <ComparisonCard item={item} horizontal />
      ))}
    </div>

    <p class="mt-12 text-center text-xs font-light text-white/40 italic" data-reveal>
      Resultados reais de pacientes, publicados com autorização de uso de imagem.
      Os resultados variam de pessoa para pessoa.
    </p>

    <div class="mt-10 text-center" data-reveal>
      <a href={waLink("Olá! Vi os resultados no site e gostaria de agendar uma avaliação.")} target="_blank" rel="noopener" class="btn btn-gold">
        Quero um resultado assim
      </a>
    </div>
  </div>
</section>

<script>
  // Cada slider: o input range invisível controla a posição do corte (--pos)
  let interacted = false;
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>(".ba-range");
    if (!range) return;
    range.disabled = false;
    const setPos = () => {
      frame.style.setProperty("--pos", `${range.value}%`);
      range.setAttribute("aria-valuetext", `${range.value}% antes, ${100 - Number(range.value)}% depois`);
    };
    setPos();
    range?.addEventListener("input", () => {
      interacted = true;
      setPos();
    });
    range?.addEventListener("pointerdown", () => (interacted = true), { once: true });
  });

  // Dica de uso: o primeiro slider desliza sozinho uma vez ao entrar na tela
  const firstFrame = document.querySelector<HTMLElement>("[data-compare]");
  if (firstFrame && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const hintIo = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        hintIo.disconnect();
        if (interacted) return;
        const range = firstFrame.querySelector<HTMLInputElement>(".ba-range")!;
        setTimeout(() => {
          const start = performance.now();
          const duration = 1800;
          const tick = (now: number) => {
            if (interacted || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            const p = Math.min(1, (now - start) / duration);
            const v = 50 + Math.sin(p * Math.PI * 2) * 22 * Math.sin(p * Math.PI);
            firstFrame.style.setProperty("--pos", `${v}%`);
            range.value = String(v);
            range.setAttribute("aria-valuetext", `${Math.round(v)}% antes, ${100 - Math.round(v)}% depois`);
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, 600);
      },
      { threshold: 0.55 }
    );
    hintIo.observe(firstFrame);
  }
</script>
