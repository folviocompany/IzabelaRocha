---
import { beforeAfter, waLink } from "../data/site";

const portraits = beforeAfter.filter((c) => c.layout === "portrait");
const square = beforeAfter.find((c) => c.layout === "square");
const wide = beforeAfter.find((c) => c.layout === "wide");
---

<section id="resultados" class="grain relative overflow-hidden bg-wine-950 py-24 lg:py-32">
  <!-- Brilho decorativo com parallax -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div
      class="h-96 w-[50rem] rounded-full opacity-15 blur-3xl"
      style="background: radial-gradient(circle, rgba(201,162,39,0.8) 0%, transparent 60%)"
      data-parallax="0.18"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow eyebrow-center text-gold-400">Antes & Depois</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-white sm:text-[2.6rem] sm:leading-tight">
        Resultados que falam <em class="gold-text gold-shimmer italic">por si</em>
      </h2>
      <p class="mt-5 text-base leading-relaxed font-light text-white/60">
        Arraste a linha para comparar o antes e o depois. Casos reais de pacientes,
        fruto de avaliação criteriosa e técnica apurada.
      </p>
    </div>

    <!-- Casos verticais: cards na proporção natural das fotos -->
    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {portraits.map((item, i) => (
        <figure data-reveal style={`--reveal-delay: ${(i % 4) * 0.08}s`}>
          <div class="ba aspect-[1/2] rounded-2xl ring-1 ring-gold-500/30" data-compare>
            <img class="ba-before" src={item.before} alt={`Antes: ${item.title}`} loading="lazy" decoding="async" />
            <img class="ba-after" src={item.after} alt={`Depois: ${item.title}`} loading="lazy" decoding="async" />
            <span class="pointer-events-none absolute top-3 left-3 z-10 rounded-full bg-wine-950/70 px-2.5 py-1 text-[0.58rem] font-bold tracking-[0.16em] text-white/85 uppercase backdrop-blur-sm">Antes</span>
            <span class="pointer-events-none absolute top-3 right-3 z-10 rounded-full bg-gold-500/90 px-2.5 py-1 text-[0.58rem] font-bold tracking-[0.16em] text-wine-950 uppercase backdrop-blur-sm">Depois</span>
            <div class="ba-divider">
              <div class="ba-handle">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 8l-4 4 4 4M14 8l4 4-4 4" />
                </svg>
              </div>
            </div>
            <input type="range" min="0" max="100" value="50" class="ba-range" aria-label={`Comparar antes e depois de ${item.title}`} />
          </div>
          <figcaption class="mt-4 px-1">
            <p class="font-display text-base text-white sm:text-lg">{item.title}</p>
            <p class="mt-1 text-xs font-light text-white/60 sm:text-sm">{item.subtitle}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Casos horizontais: HIFU + Toxina em cards equilibrados no desktop -->
    <div class="mx-auto mt-6 grid max-w-4xl gap-6 sm:grid-cols-2">
      {[square, wide].filter(Boolean).map((item) => (
        <figure data-reveal>
          <div
            class:list={[
              "ba rounded-2xl ring-1 ring-gold-500/30",
              "aspect-[3/2]",
            ]}
            data-compare
          >
            <img class="ba-before" src={item!.before} alt={`Antes: ${item!.title}`} loading="lazy" decoding="async" />
            <img class="ba-after" src={item!.after} alt={`Depois: ${item!.title}`} loading="lazy" decoding="async" />
            <span class="pointer-events-none absolute top-3 left-3 z-10 rounded-full bg-wine-950/70 px-2.5 py-1 text-[0.58rem] font-bold tracking-[0.16em] text-white/85 uppercase backdrop-blur-sm">Antes</span>
            <span class="pointer-events-none absolute top-3 right-3 z-10 rounded-full bg-gold-500/90 px-2.5 py-1 text-[0.58rem] font-bold tracking-[0.16em] text-wine-950 uppercase backdrop-blur-sm">Depois</span>
            <div class="ba-divider">
              <div class="ba-handle">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 8l-4 4 4 4M14 8l4 4-4 4" />
                </svg>
              </div>
            </div>
            <input type="range" min="0" max="100" value="50" class="ba-range" aria-label={`Comparar antes e depois de ${item!.title}`} />
          </div>
          <figcaption class="mt-4 px-1">
            <p class="font-display text-base text-white sm:text-lg">{item!.title}</p>
            <p class="mt-1 text-xs font-light text-white/60 sm:text-sm">{item!.subtitle}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-12 text-center text-xs font-light text-white/40 italic" data-reveal>
      Resultados reais de pacientes, publicados com autorização de uso de imagem.
      Os resultados variam de pessoa para pessoa.
    </p>

    <div class="mt-10 text-center" data-reveal>
      <a href={waLink("Olá! Vi os resultados no site e gostaria de agendar uma avaliação.")} target="_blank" rel="noopener" class="btn btn-gold">
        Quero um resultado assim
      </a>
    </div>
  </div>
</section>

<script>
  // Cada slider: o input range invisível controla a posição do corte (--pos)
  let interacted = false;
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>(".ba-range");
    const setPos = () => frame.style.setProperty("--pos", `${range!.value}%`);
    range?.addEventListener("input", () => {
      interacted = true;
      setPos();
    });
    range?.addEventListener("pointerdown", () => (interacted = true), { once: true });
  });

  // Dica de uso: o primeiro slider desliza sozinho uma vez ao entrar na tela
  const firstFrame = document.querySelector<HTMLElement>("[data-compare]");
  if (firstFrame && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const hintIo = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        hintIo.disconnect();
        if (interacted) return;
        const range = firstFrame.querySelector<HTMLInputElement>(".ba-range")!;
        setTimeout(() => {
          const start = performance.now();
          const duration = 1800;
          const tick = (now: number) => {
            if (interacted) return;
            const p = Math.min(1, (now - start) / duration);
            const v = 50 + Math.sin(p * Math.PI * 2) * 22 * Math.sin(p * Math.PI);
            firstFrame.style.setProperty("--pos", `${v}%`);
            range.value = String(v);
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, 600);
      },
      { threshold: 0.55 }
    );
    hintIo.observe(firstFrame);
  }
</script>
