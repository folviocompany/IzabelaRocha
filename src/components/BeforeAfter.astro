---
import { beforeAfter, waLink } from "../data/site";
---

<section id="resultados" class="grain relative overflow-hidden bg-wine-950 py-24 lg:py-32">
  <!-- Brilho decorativo com parallax -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div
      class="h-96 w-[50rem] rounded-full opacity-15 blur-3xl"
      style="background: radial-gradient(circle, rgba(201,162,39,0.8) 0%, transparent 60%)"
      data-parallax="0.18"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow eyebrow-center text-gold-400">Antes & Depois</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-white sm:text-[2.6rem] sm:leading-tight">
        Resultados que falam <em class="gold-text gold-shimmer italic">por si</em>
      </h2>
      <p class="mt-5 text-base leading-relaxed font-light text-white/60">
        Casos reais de pacientes. Cada resultado é fruto de avaliação criteriosa,
        técnica apurada e respeito às características de cada pessoa.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {beforeAfter.map((item, i) => (
        <figure class="group" data-reveal style={`--reveal-delay: ${(i % 3) * 0.1}s`}>
          <div class="relative aspect-square overflow-hidden rounded-2xl bg-wine-950 ring-1 ring-gold-500/30 transition-all duration-500 group-hover:ring-gold-400/70">
            <!-- Preenche o quadrado com uma versão suave da própria foto (fotos verticais não ficam com barras vazias) -->
            <img
              src={item.image}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 z-0 h-full w-full scale-125 object-cover opacity-60 blur-2xl"
            />
            <img
              src={item.image}
              alt={`Resultado de antes e depois: ${item.title}`}
              class="relative z-10 h-full w-full object-contain transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
              width={item.w}
              height={item.h}
              loading="lazy"
              decoding="async"
            />
            <div class="pointer-events-none absolute inset-0 z-20 bg-gradient-to-t from-wine-950/45 via-transparent to-transparent"></div>
          </div>
          <figcaption class="mt-4 px-1">
            <p class="font-display text-lg text-white">{item.title}</p>
            <p class="mt-1 text-sm font-light text-white/50">{item.subtitle}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-12 text-center text-xs font-light text-white/40 italic" data-reveal>
      Resultados reais de pacientes, publicados com autorização de uso de imagem.
      Os resultados variam de pessoa para pessoa.
    </p>

    <div class="mt-10 text-center" data-reveal>
      <a href={waLink("Olá! Vi os resultados no site e gostaria de agendar uma avaliação.")} target="_blank" rel="noopener" class="btn btn-gold">
        Quero um resultado assim
      </a>
    </div>
  </div>
</section>
