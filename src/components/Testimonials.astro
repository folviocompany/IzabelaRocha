---
import { testimonials } from "../data/site";
---

<section id="depoimentos" class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow eyebrow-center text-gold-700">Depoimentos</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-wine-900 sm:text-[2.6rem] sm:leading-tight">
        Quem confia, <em class="text-wine-700 italic">recomenda</em>
      </h2>
    </div>

    <!-- Grid no desktop; carrossel com scroll-snap no mobile -->
    <div class="mt-16 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-3 md:overflow-visible md:pb-0">
      {testimonials.map((t, i) => (
        <figure
          class="relative flex w-[85%] shrink-0 snap-center flex-col rounded-3xl border border-wine-100 bg-cream/70 p-8 transition-all duration-500 hover:-translate-y-1.5 hover:border-gold-300 hover:shadow-[0_30px_60px_-30px_rgba(46,8,19,0.25)] md:w-auto"
          data-reveal
          style={`--reveal-delay: ${i * 0.12}s`}
        >
          <span class="font-display absolute top-5 right-7 text-7xl leading-none text-gold-500/20 select-none" aria-hidden="true">”</span>

          <div class="flex gap-1 text-gold-500" aria-label="Avaliação: 5 de 5 estrelas">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
              </svg>
            ))}
          </div>

          <blockquote class="mt-5 flex-1 text-[0.95rem] leading-relaxed font-light text-ink/70">
            {t.text}
          </blockquote>

          <figcaption class="mt-7 flex items-center gap-4 border-t border-wine-100 pt-6">
            <img
              src={t.avatar}
              alt={`Foto de ${t.name}`}
              class="h-12 w-12 rounded-full object-cover ring-2 ring-gold-400/60 ring-offset-2 ring-offset-cream"
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="text-sm font-semibold text-wine-900">{t.name}</p>
              <p class="mt-0.5 text-xs tracking-wide text-gold-700 uppercase">{t.procedure}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-8 text-center text-xs font-light text-ink/40 italic md:hidden" data-reveal>
      Deslize para o lado para ver mais depoimentos →
    </p>
  </div>
</section>
