---
import { services, waLink } from "../data/site";

// Ícones de linha, desenhados para manter a elegância da identidade
const icons: Record<string, string> = {
  sparkle: `<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/><path d="M19 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z"/>`,
  droplet: `<path d="M12 3s6 6.4 6 10.6a6 6 0 1 1-12 0C6 9.4 12 3 12 3z"/><path d="M9.5 13.5a2.6 2.6 0 0 0 2 2.6"/>`,
  lotus: `<path d="M12 20c-2.5-1.5-4-4-4-7 0-2.5 1.5-5.5 4-8 2.5 2.5 4 5.5 4 8 0 3-1.5 5.5-4 7z"/><path d="M12 20c-3.5.5-6.5-.5-8.5-3 1.8-.8 3.6-1.1 5.3-.8M12 20c3.5.5 6.5-.5 8.5-3-1.8-.8-3.6-1.1-5.3-.8"/>`,
  waves: `<path d="M3 9c2.2 0 2.2 1.8 4.5 1.8S9.8 9 12 9s2.2 1.8 4.5 1.8S18.8 9 21 9"/><path d="M3 14.5c2.2 0 2.2 1.8 4.5 1.8s2.3-1.8 4.5-1.8 2.2 1.8 4.5 1.8 2.3-1.8 4.5-1.8"/>`,
  leaf: `<path d="M5 19C5 10.5 10.5 5 19 5c0 8.5-5.5 14-14 14z"/><path d="M5 19c3-3 6-6 10-8"/>`,
  dots: `<circle cx="6" cy="6" r="1"/><circle cx="12" cy="6" r="1"/><circle cx="18" cy="6" r="1"/><circle cx="6" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="18" cy="12" r="1"/><circle cx="6" cy="18" r="1"/><circle cx="12" cy="18" r="1"/><circle cx="18" cy="18" r="1"/>`,
  focus: `<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.8"/><circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/>`,
  face: `<circle cx="12" cy="12" r="9"/><path d="M9 10.5h.01M15 10.5h.01"/><path d="M9 14.5c1.6 1.4 4.4 1.4 6 0"/>`,
  body: `<path d="M14 3.6a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/><path d="M9.5 8c-1.2 1-1.8 2.5-1.2 4 .5 1.3 2 1.8 2 3.2 0 1.6-1.3 2.4-1.3 4.6M14.5 8c1.2 1 1.8 2.5 1.2 4-.5 1.3-2 1.8-2 3.2 0 1.6 1.3 2.4 1.3 4.6"/>`,
  layers: `<path d="M12 4l8 4-8 4-8-4 8-4z"/><path d="M4 12l8 4 8-4"/><path d="M4 16l8 4 8-4"/>`,
  nose: `<path d="M12 4v8.5c0 1-.7 1.8-1.7 2M12 12.5c0 1 .7 1.8 1.7 2"/><path d="M9 16.5c1.8 1.2 4.2 1.2 6 0"/>`,
  thread: `<path d="M5 19L19 5"/><circle cx="5" cy="19" r="1.5"/><circle cx="19" cy="5" r="1.5"/><path d="M10 11l3 3"/>`,
  light: `<circle cx="12" cy="12" r="3.5"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>`,
};

const featured = services.find((s) => s.featured);
const rest = services.filter((s) => !s.featured);

// Diferenciais mostrados no card de destaque
const featuredPerks = ["Proporção e simetria", "Resultado natural", "Plano 100% personalizado"];
---

<section id="tratamentos" class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow eyebrow-center text-gold-700">Tratamentos</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-wine-900 sm:text-[2.6rem] sm:leading-tight" data-split>
        Protocolos pensados para <em class="text-wine-700 italic">a sua</em> beleza
      </h2>
      <p class="mt-5 text-base leading-relaxed font-light text-ink/60">
        Cada rosto é único. Por isso, todo tratamento começa com uma avaliação criteriosa
        e um plano personalizado para os seus objetivos.
      </p>
    </div>

    <!-- Tratamento em destaque (card largo) -->
    {featured && (
      <article
        class="grain group relative mt-16 overflow-hidden rounded-3xl bg-gradient-to-br from-wine-700 to-wine-900 text-white shadow-[0_40px_80px_-35px_rgba(92,19,41,0.8)]"
        data-reveal
      >
        <!-- Brilho decorativo -->
        <div
          class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full opacity-25 blur-3xl"
          style="background: radial-gradient(circle, rgba(201,162,39,0.7) 0%, transparent 65%)"
          aria-hidden="true"
        >
        </div>

        <span class="absolute top-6 right-6 z-10 rounded-full bg-gold-500 px-4 py-1 text-[0.62rem] font-bold tracking-[0.18em] text-wine-950 uppercase shadow-md">
          Em destaque
        </span>

        <div class="relative grid gap-10 p-8 sm:p-10 lg:grid-cols-[1.5fr_1fr] lg:items-center lg:gap-12 lg:p-12">
          <div>
            <span class="grid h-16 w-16 place-items-center rounded-2xl bg-white/10 text-gold-300" aria-hidden="true">
              <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons[featured.icon]} />
            </span>
            <h3 class="font-display mt-6 text-3xl font-medium text-white sm:text-4xl">{featured.name}</h3>
            <p class="mt-4 max-w-xl text-base leading-relaxed font-light text-white/75">{featured.description}</p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a href={waLink(`Olá! Gostaria de agendar uma avaliação de ${featured.name}.`)} target="_blank" rel="noopener" class="btn btn-gold">
                Agendar {featured.name}
              </a>
              <span class="text-[0.68rem] font-semibold tracking-[0.22em] text-gold-300 uppercase">{featured.price}</span>
            </div>
          </div>

          <ul class="space-y-3.5 lg:border-l lg:border-white/15 lg:pl-10">
            {featuredPerks.map((perk) => (
              <li class="flex items-center gap-3 text-[0.95rem] font-light text-white/85">
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gold-500/20 text-gold-300" aria-hidden="true">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {perk}
              </li>
            ))}
          </ul>
        </div>
      </article>
    )}

    <!-- Demais tratamentos -->
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((service, i) => (
        <article
          class="spotlight-card group relative flex flex-col rounded-3xl border border-wine-100 bg-cream/60 p-8 transition-all duration-500 hover:-translate-y-1.5 hover:border-gold-300 hover:shadow-[0_30px_60px_-30px_rgba(46,8,19,0.25)]"
          data-reveal
          style={`--reveal-delay: ${(i % 3) * 0.1}s`}
        >
          <span class="grid h-14 w-14 place-items-center rounded-2xl bg-wine-50 text-wine-700 transition-colors duration-500 group-hover:bg-gold-100 group-hover:text-gold-700" aria-hidden="true">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons[service.icon]} />
          </span>

          <h3 class="font-display mt-6 text-xl font-medium text-wine-900">{service.name}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed font-light text-ink/60">{service.description}</p>

          <div class="mt-7 flex items-center justify-between border-t border-wine-100 pt-5">
            <span class="text-[0.68rem] font-semibold tracking-[0.22em] text-gold-700 uppercase">{service.price}</span>
            <a
              href={service.anchor ?? waLink(`Olá! Gostaria de saber mais sobre ${service.name}.`)}
              target={service.anchor ? undefined : "_blank"}
              rel={service.anchor ? undefined : "noopener"}
              class="inline-flex items-center gap-1.5 text-[0.72rem] font-semibold tracking-[0.14em] text-wine-700 uppercase transition-all duration-300 hover:text-wine-800"
            >
              {service.anchor ? "Ver detalhes" : "Agendar"}
              <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Spotlight dourado seguindo o cursor (desktop)
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.querySelectorAll<HTMLElement>(".spotlight-card").forEach((card) => {
      card.addEventListener(
        "mousemove",
        (e) => {
          if (reduced.matches) return;
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
          card.style.setProperty("--my", `${e.clientY - rect.top}px`);
        },
        { passive: true }
      );
    });
  }
</script>
