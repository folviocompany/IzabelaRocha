---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "alt"> {
  src: string;
  alt: string;
  cropAspectRatio?: number;
}
const { src, alt, sizes = "100vw", cropAspectRatio, width: _width, height: _height, ...attributes } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("/public/**/*.jpeg", { eager: true });
const source = images["/public" + src]?.default;
if (!source) throw new Error("Imagem local nao encontrada: " + src);
const widths = [...new Set([320, 480, 640, 960, 1280, source.width].filter((w) => w <= source.width))];
// object-fit: cover pode ampliar uma foto horizontal dentro de um card vertical.
const cropScale = cropAspectRatio ? Math.max(1, source.width / source.height / cropAspectRatio) : 1;
const responsiveSizes = cropScale === 1 ? sizes : sizes.split(",").map((clause) => {
  const [, media = "", length] = clause.trim().match(/^(\([^)]*\)\s+)?(.+)$/)!;
  return `${media}calc(${length} * ${cropScale})`;
}).join(", ");
---
<Image src={source} alt={alt} widths={widths} sizes={responsiveSizes} format="webp" quality={85} {...attributes} />
