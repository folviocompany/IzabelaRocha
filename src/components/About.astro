---
import { site, images, about, waLink } from "../data/site";

const patientsStat = site.stats.find((s) => s.label === "pacientes atendidos") ?? site.stats[0];
---

<section id="sobre" class="bg-cream py-24 lg:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-16 px-5 lg:grid-cols-[5fr_6fr] lg:gap-20 lg:px-8">
    <!-- Foto com moldura dourada e selo de pacientes -->
    <div class="relative mx-auto w-full max-w-md" data-reveal>
      <div class="absolute -inset-3 translate-x-4 translate-y-4 rounded-3xl border border-gold-400/60" aria-hidden="true"></div>
      <div class="relative rounded-3xl shadow-[0_35px_70px_-30px_rgba(46,8,19,0.4)]" data-curtain>
        <img
          src={images.about}
          alt={`${site.name}, responsável técnica pela clínica`}
          class="aspect-[4/5] w-full rounded-3xl object-cover"
          width="700"
          height="875"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="absolute -bottom-7 -right-3 rounded-2xl bg-wine-700 px-6 py-5 text-center shadow-[0_20px_45px_-15px_rgba(92,19,41,0.7)] sm:-right-7">
        <p class="font-display text-4xl font-medium text-gold-300">
          {patientsStat.prefix}{patientsStat.value.toLocaleString("pt-BR")}
        </p>
        <p class="mt-1 max-w-[7rem] text-[0.62rem] leading-snug tracking-[0.18em] text-white/75 uppercase">
          {patientsStat.label}
        </p>
      </div>
    </div>

    <!-- História -->
    <div>
      <p class="eyebrow text-gold-700" data-reveal>{about.eyebrow}</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-wine-900 sm:text-[2.6rem] sm:leading-tight" data-split>
        {about.heading}
      </h2>

      {about.paragraphs.map((paragraph, i) => (
        <p class="mt-5 text-base leading-relaxed font-light text-ink/70" data-reveal style={`--reveal-delay: ${0.15 + i * 0.06}s`}>
          {paragraph}
        </p>
      ))}

      <!-- Bordão da marca -->
      <blockquote class="mt-9 border-l-2 border-gold-500 pl-5" data-reveal style="--reveal-delay: 0.35s">
        <p class="font-display text-2xl leading-snug text-wine-800 italic sm:text-[1.7rem]">
          “Eu não transformo rostos. <span class="gold-text">Revelo identidades.</span>”
        </p>
      </blockquote>

      <ul class="mt-9 grid gap-3.5 sm:grid-cols-2" data-reveal style="--reveal-delay: 0.42s">
        {about.credentials.map((credential) => (
          <li class="flex items-start gap-3 text-[0.95rem] font-light text-ink/75">
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-gold-100 text-gold-700" aria-hidden="true">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7" />
              </svg>
            </span>
            {credential}
          </li>
        ))}
      </ul>

      <div class="mt-10" data-reveal style="--reveal-delay: 0.5s">
        <a href={waLink("Olá! Gostaria de agendar uma avaliação com a Dra. Izabela.")} target="_blank" rel="noopener" class="btn btn-wine">
          Agendar com a Dra. Izabela
        </a>
      </div>
    </div>
  </div>
</section>
