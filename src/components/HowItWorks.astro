---
import { steps, waLink } from "../data/site";
---

<section id="como-funciona" class="bg-cream py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow eyebrow-center text-gold-700">Como funciona</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-wine-900 sm:text-[2.6rem] sm:leading-tight" data-split>
        Um caminho <em class="text-wine-700 italic">simples e seguro</em>
      </h2>
      <p class="mt-5 text-base leading-relaxed font-light text-ink/60">
        Do primeiro contato ao resultado final, você sabe exatamente o que esperar em cada etapa.
      </p>
    </div>

    <div class="relative mt-16 grid gap-10 md:grid-cols-3 md:gap-8">
      <!-- Linha conectora (desktop) -->
      <div class="absolute top-10 right-[16%] left-[16%] hidden border-t border-dashed border-gold-400/50 md:block" aria-hidden="true"></div>

      {steps.map((step, i) => (
        <div class="relative text-center" data-reveal style={`--reveal-delay: ${i * 0.15}s`}>
          <div class="relative mx-auto grid h-20 w-20 place-items-center rounded-full border border-gold-400 bg-cream shadow-[0_10px_30px_-12px_rgba(201,162,39,0.5)]">
            <span class="font-display text-2xl font-medium text-wine-700">{step.number}</span>
            <span class="absolute -inset-1.5 rounded-full border border-gold-400/30" aria-hidden="true"></span>
          </div>
          <h3 class="font-display mt-6 text-xl font-medium text-wine-900">{step.title}</h3>
          <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed font-light text-ink/60">{step.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 text-center" data-reveal>
      <a href={waLink("Olá! Gostaria de começar pela avaliação personalizada.")} target="_blank" rel="noopener" class="btn btn-wine">
        Começar pela avaliação
      </a>
    </div>
  </div>
</section>
