---
import { site, services, waLink } from "../data/site";

const year = new Date().getFullYear();
const nav = [
  { label: "Tratamentos", href: "#tratamentos" },
  { label: "Resultados", href: "#resultados" },
  { label: "Sobre", href: "#sobre" },
  { label: "Depoimentos", href: "#depoimentos" },
  { label: "Localização", href: "#localizacao" },
];
---

<footer id="contato" class="grain relative overflow-hidden bg-wine-950 text-white/70">
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-10 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1.4fr_1.4fr]">
      <!-- Marca -->
      <div>
        <p class="font-display text-2xl font-semibold text-white">
          Izabela <span class="italic text-gold-400">Rocha</span>
        </p>
        <p class="mt-1 text-[0.6rem] font-medium tracking-[0.42em] text-white/50 uppercase">Estética Avançada</p>
        <p class="mt-5 max-w-xs text-sm leading-relaxed font-light text-white/50">
          Estética avançada com resultados naturais, técnica e acolhimento — para
          você se sentir bem na sua própria pele.
        </p>
        <div class="mt-6 flex gap-3">
          <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-white/60 transition-all duration-300 hover:border-gold-400 hover:text-gold-400">
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href={waLink()} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-white/60 transition-all duration-300 hover:border-gold-400 hover:text-gold-400">
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.5 14.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.9 1.22 3.1.15.2 2.1 3.2 5.1 4.49.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35M12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.4 9.4 0 0 1-1.45-5.03c0-5.21 4.25-9.45 9.47-9.45a9.4 9.4 0 0 1 6.69 2.77 9.4 9.4 0 0 1 2.77 6.7c0 5.21-4.25 9.44-9.46 9.44m8.05-17.5A11.3 11.3 0 0 0 12.03.68C5.77.68.68 5.77.68 12.02c0 2 .52 3.95 1.52 5.67L.6 23.5l5.94-1.56a11.35 11.35 0 0 0 5.48 1.4h.01c6.26 0 11.35-5.1 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navegação -->
      <nav aria-label="Links do rodapé">
        <h3 class="text-xs font-semibold tracking-[0.24em] text-gold-400 uppercase">Navegação</h3>
        <ul class="mt-5 space-y-3">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm font-light text-white/55 transition-colors duration-300 hover:text-gold-300">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Tratamentos -->
      <div>
        <h3 class="text-xs font-semibold tracking-[0.24em] text-gold-400 uppercase">Tratamentos</h3>
        <ul class="mt-5 space-y-3">
          {services.map((service) => (
            <li>
              <a
                href={waLink(`Olá! Gostaria de saber mais sobre ${service.name}.`)}
                target="_blank"
                rel="noopener"
                class="text-sm font-light text-white/55 transition-colors duration-300 hover:text-gold-300"
              >
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contato -->
      <div>
        <h3 class="text-xs font-semibold tracking-[0.24em] text-gold-400 uppercase">Contato</h3>
        <ul class="mt-5 space-y-3 text-sm font-light text-white/55">
          <li>
            {site.address.street}<br />
            {site.address.district} · {site.address.city}
          </li>
          <li>
            <a href={waLink()} target="_blank" rel="noopener" class="transition-colors duration-300 hover:text-gold-300">
              Atendimento via WhatsApp
            </a>
          </li>
          <li>{site.hours[0].days}: {site.hours[0].time}</li>
          <li>{site.hours[1].days}: {site.hours[1].time}</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-7 text-center">
      <p class="text-xs font-light text-white/40">
        © {year} {site.name} — Todos os direitos reservados.
      </p>
      <p class="mt-2 text-[0.68rem] font-light text-white/30">
        Responsável técnica: {site.name} · {site.register}
      </p>
    </div>
  </div>
</footer>
