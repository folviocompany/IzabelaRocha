---
import { site, images } from "../data/site";
---

<section id="espaco" class="overflow-hidden bg-white py-24 lg:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-[6fr_5fr] lg:gap-16 lg:px-8">
    <!-- Galeria assimétrica -->
    <div class="grid grid-cols-[3fr_2fr] items-start gap-5">
      <div class="group overflow-hidden rounded-3xl" data-curtain>
        <img
          src={images.ambiente1}
          alt="Ambiente acolhedor da clínica"
          class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-105"
          width="720"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="group mt-14 overflow-hidden rounded-3xl border border-gold-300/60 p-2" data-curtain>
        <img
          src={images.ambiente2}
          alt="Sala de procedimentos da clínica"
          class="aspect-[3/4] w-full rounded-2xl object-cover transition-transform duration-700 group-hover:scale-105"
          width="480"
          height="640"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Texto -->
    <div>
      <p class="eyebrow text-gold-700" data-reveal>O espaço</p>
      <h2 class="font-display mt-5 text-3xl font-medium text-wine-900 sm:text-[2.6rem] sm:leading-tight" data-split>
        Cada detalhe pensado para <em class="text-wine-700 italic">você relaxar</em>
      </h2>
      <p class="mt-6 text-base leading-relaxed font-light text-ink/70" data-reveal style="--reveal-delay: 0.18s">
        Do aroma ao acolhimento, o espaço foi desenhado para que a sua experiência comece
        antes mesmo do procedimento — um ambiente privativo, silencioso e impecável.
      </p>
      <p class="mt-4 text-base leading-relaxed font-light text-ink/70" data-reveal style="--reveal-delay: 0.24s">
        Acompanhe os bastidores, resultados e novidades no nosso Instagram.
      </p>
      <div class="mt-8" data-reveal style="--reveal-delay: 0.3s">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          class="btn border border-wine-200 text-wine-700 hover:border-gold-400 hover:text-gold-700"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
          </svg>
          {site.instagramHandle}
        </a>
      </div>
    </div>
  </div>
</section>
