---
import "../styles/global.css";
import { site, images } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${site.name}, Estética Avançada e Harmonização Facial`,
  description = site.description,
  noindex = false,
} = Astro.props;

// OG/JSON-LD precisam de URL absoluta para os crawlers das redes sociais
const ogImage = images.og.startsWith("http") ? images.og : `${site.siteUrl}${images.og}`;

const canonical = new URL(Astro.url.pathname, site.siteUrl).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  name: site.name,
  description: site.description,
  image: ogImage,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressCountry: "BR",
  },
  openingHours: site.hours.flatMap((h) => h.schema ? [h.schema] : []),
  sameAs: [site.instagram],
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7B1E3A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph (WhatsApp / Instagram / Facebook) -->
    <meta property="og:type" content="website" />
    {site.siteUrl && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <!-- Decide antes da pintura se a intro de marca roda (1x por sessão) -->
    <script is:inline data-intro-enabled={!noindex}>
      (function () {
        try {
          if (
            document.currentScript?.dataset.introEnabled !== "true" ||
            sessionStorage.getItem("introDone") ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            document.documentElement.classList.add("no-intro");
          } else {
            document.documentElement.classList.add("intro-active");
            // Libera o site mesmo se o modulo principal nao carregar.
            setTimeout(() => {
              document.documentElement.classList.remove("intro-active", "intro-opening");
              document.dispatchEvent(new Event("intro-ready"));
            }, 3000);
          }
        } catch (e) {
          document.documentElement.classList.add("no-intro");
        }
      })();
    </script>
  </head>
  <body class="bg-cream font-sans text-ink antialiased">
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

    <!-- Intro de marca -->
    <div id="intro" aria-hidden="true">
      <div class="intro-panel intro-panel-left"></div>
      <div class="intro-panel intro-panel-right"></div>
      <div class="intro-brand">
        <span class="intro-mono font-display">IR</span>
        <span class="intro-name">Izabela Rocha</span>
        <span class="intro-sub">Estética Avançada</span>
      </div>
    </div>

    <div id="scroll-progress" aria-hidden="true"></div>
    <slot />
    <div id="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    <script>
      import { initIntro } from "../scripts/intro";
      import { initReveals } from "../scripts/reveals";
      import { initEffects } from "../scripts/effects";
      initIntro();
      initReveals();
      initEffects();
    </script>
  </body>
</html>
